# frien environment variable overrides
# Copy this file to .env and fill in real values.

# Node identity
FRIEN_NODE_ID=node.edge.example.01
FRIEN_NODE_ZONE=edge-us-east
FRIEN_NODE_ROLE=edge

# Certificate paths
FRIEN_IDENTITY_CERT_PATH=/etc/frien/keys/node.crt
FRIEN_IDENTITY_KEY_PATH=/etc/frien/keys/node.key
FRIEN_IDENTITY_CA_CERT_PATH=/etc/frien/ca.crt

# Transport
FRIEN_TRANSPORT_PEER_PORT=7443

# Storage
FRIEN_STORAGE_WAL_DIR=/var/lib/frien/wal
FRIEN_STORAGE_DB_PATH=/var/lib/frien/state.db

# Admin API
FRIEN_ADMIN_API_SOCKET=/run/frien/admin.sock

# Observability
FRIEN_OBSERVABILITY_LOG_LEVEL=info

# Secrets (must be set via env only — never in config file)
# FRIEN_ENFORCEMENT_SIEM_AUTH_HEADER=Bearer <token>

# Seed nodes (comma-separated)
# FRIEN_SEEDS=10.0.1.10:7443,10.0.1.11:7443
